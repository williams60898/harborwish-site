---
import Base from '../../layouts/Base.astro';
import AnimalCard from '../../components/AnimalCard.astro';
import { SITE_NAME } from '../../site.config.mjs';
import { getAnimals, animalPath, progressLine } from '../../lib/animals';

const animals = await getAnimals();
const progress = progressLine(animals.length);

const description =
  'Meet the Harborwish mood animals, each a different way of feeling. Open any one that catches your eye and see whether it sounds like you right now.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Meet the 64 Mood Animals',
  url: new URL('/animals/', Astro.site).href,
  description,
  inLanguage: 'en',
  isPartOf: { '@type': 'WebSite', name: SITE_NAME, url: new URL('/', Astro.site).href },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: animals.length,
    itemListElement: animals.map((animal, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: animal.data.name,
      url: new URL(animalPath(animal.id), Astro.site).href,
    })),
  },
};
---

<Base
  title={`Meet the 64 Mood Animals | ${SITE_NAME}`}
  description={description}
  canonicalPath="/animals/"
  jsonLd={jsonLd}
>
  <h1>Meet the 64 Mood Animals</h1>
  <p class="lede">
    Take your time. Each mood animal holds a different way of feeling — open any one that catches your eye.
  </p>

  <ul class="animal-grid">
    {animals.map((animal) => <AnimalCard animal={animal} />)}
  </ul>

  {progress && <p class="grid-note">{progress}</p>}
</Base>
