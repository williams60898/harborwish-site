---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { SITE_NAME, SITE_URL } from '../../site.config.mjs';
import {
  getAnimals,
  animalPath,
  animalTitle,
  linkNeighbors,
  addHelpLine,
  ogImagePath,
  OG_IMAGE_SIZE,
  type Animal,
} from '../../lib/animals';

export async function getStaticPaths() {
  const animals = await getAnimals();
  const existing = new Set(animals.map((a) => a.id));
  return animals.map((animal) => ({ params: { slug: animal.id }, props: { animal, existing } }));
}

const { animal, existing } = Astro.props as { animal: Animal; existing: Set<string> };
const { data } = animal;

// Body from the content file, with neighbor names linked only where their page exists.
const rendered = animal.rendered?.html;
if (!rendered) throw new Error(`No rendered body for ${animal.id}`);
// Pages with an "If This Page Cuts Too Deep" section also get the help line at its end.
const body = addHelpLine(linkNeighbors(rendered, data.neighbors, existing).html).html;

const path = animalPath(animal.id);
const site = Astro.site!;
const url = new URL(path, site).href;
const home = new URL('/', site).href;
const title = animalTitle(animal);
const ogImage = ogImagePath(animal.id);
const ogImageUrl = new URL(ogImage, site).href;

const organization = { '@type': 'Organization', '@id': `${SITE_URL}/#organization`, name: SITE_NAME, url: home };
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: data.name,
    description: data.description,
    url,
    mainEntityOfPage: url,
    image: ogImageUrl,
    inLanguage: 'en',
    author: organization,
    publisher: organization,
    isPartOf: { '@id': `${SITE_URL}/#website` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: home },
      { '@type': 'ListItem', position: 2, name: 'Mood Animals', item: new URL('/animals/', site).href },
      { '@type': 'ListItem', position: 3, name: data.name, item: url },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE_URL}/#website`,
    name: SITE_NAME,
    url: home,
    inLanguage: 'en',
    publisher: organization,
  },
];
---

<Base
  title={title}
  description={data.description}
  canonicalPath={path}
  ogImage={ogImage}
  ogImageAlt={data.image_alt}
  ogImageWidth={OG_IMAGE_SIZE.width}
  ogImageHeight={OG_IMAGE_SIZE.height}
  ogType="article"
  jsonLd={jsonLd}
>
  <nav aria-label="Breadcrumb" class="breadcrumb">
    <a href="/">Home</a> <span aria-hidden="true">›</span> <a href="/animals/">Mood Animals</a>
    <span aria-hidden="true">›</span> <span aria-current="page">{data.name}</span>
  </nav>

  <article class="animal">
    <header class="animal-header">
      <h1>{data.name}</h1>
      <p class="lede">{data.subtitle}</p>
    </header>

    <blockquote class="pull-quote voice">
      <p>“{data.voice}”</p>
    </blockquote>

    <Image
      class="poster"
      src={data.image}
      alt={data.image_alt}
      widths={[400, 800, 1086]}
      sizes="(min-width: 32rem) 480px, calc(100vw - 2rem)"
      width={data.image.width}
      height={data.image.height}
      format="webp"
      quality={80}
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />

    <p class="coordinates">{data.coordinates.join(' · ')}</p>

    <div class="animal-body" set:html={body} />

    <p class="animal-cta">
      <a class="button" href="/animals/">Meet the 64 Mood Animals</a>
    </p>
  </article>
</Base>
