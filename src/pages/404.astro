---
import Base from '../layouts/Base.astro';
import { SITE_NAME } from '../site.config.mjs';
---

{/* No canonical + noindex for the 404 page: approved by the owner. */}
<Base
  title={`Page Not Found | ${SITE_NAME}`}
  description="This page seems to have wandered off. Head back to Harborwish and meet the mood animals."
  noindex
>
  <section class="hero">
    <h1>This page has wandered off</h1>
    <p class="lede">
      You've reached a path that doesn't lead anywhere — that's okay. The animals are all still here
      waiting for you.
    </p>
    <a class="button" href="/animals/">Meet the 64 animals</a>
  </section>
</Base>
